# Installed-package entry point expanded for the components enabled at build time.
# Resolve public dependencies before loading exported targets and checking requested components.
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@RTX_GRPC@)
 find_dependency(Protobuf)
 find_dependency(gRPC CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/rtxTargets.cmake")
foreach(component core posix grpc)
 if(TARGET rtx::${component})
  set(rtx_${component}_FOUND TRUE)
 else()
  set(rtx_${component}_FOUND FALSE)
 endif()
endforeach()
check_required_components(rtx)
