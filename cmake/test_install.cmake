# Install, relocate and consume the package outside the original build tree.
# Forward cross-toolchain and emulator settings so this check also exercises foreign-architecture packages.
function(run)
 execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "${ARGV}: ${result}\n${output}\n${error}")
 endif()
endfunction()
set(stage "${RTX_BINARY_DIR}/package-stage")
set(relocated "${RTX_BINARY_DIR}/package-relocated")
set(consumer "${RTX_BINARY_DIR}/package-consumer")
file(REMOVE_RECURSE "${stage}" "${relocated}" "${consumer}")
run("${CMAKE_COMMAND}" --install "${RTX_BINARY_DIR}" --prefix "${stage}" --config "${RTX_CONFIG}")
file(RENAME "${stage}" "${relocated}")
set(toolchain_args)
if(RTX_TOOLCHAIN_FILE)
 list(APPEND toolchain_args "-DCMAKE_TOOLCHAIN_FILE=${RTX_TOOLCHAIN_FILE}")
endif()
run("${CMAKE_COMMAND}" -G "${RTX_GENERATOR}" -S "${RTX_SOURCE_DIR}/tests/consumer" -B "${consumer}" "-DCMAKE_PREFIX_PATH=${relocated}" "-DCMAKE_BUILD_TYPE=${RTX_CONFIG}" "-DCMAKE_CROSSCOMPILING_EMULATOR=${RTX_EMULATOR}" ${toolchain_args})
run("${CMAKE_COMMAND}" --build "${consumer}" --config "${RTX_CONFIG}" -j 2)
run("${CMAKE_CTEST_COMMAND}" --test-dir "${consumer}" --build-config "${RTX_CONFIG}" --output-on-failure)
